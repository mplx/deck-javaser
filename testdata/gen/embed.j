# Embed the streams Fixtures.java wrote as gzip + base64 constants, for the
# test overlays (jvc runs them from a copy of src/ alone, so the fixtures
# must live in src/):
#
#   jennifer run testdata/gen/embed.j DIR > src/topics/fixtures/streams_test.j
use compress;
use encoding;
use fs;
use io;
use lists;
use os;
use path;
use strings;

def dir as string init os.ARGS[len(os.ARGS) - 1];
def names as list of string init lists.sort(fs.list($dir));
def entries as list of string init [];
for (def name in $names) {
    if (strings.endsWith($name, ".ser")) {
        def packed as bytes init compress.pack(
            "gzip",
            fs.readBytes(path.join($dir, $name)),
            "best");
        $entries[] = io.sprintf(
            "    \"%s\": \"%s\"",
            path.stem($name),
            encoding.toText("base64", $packed));
    }
}
io.printf(
    "%s",
    '# SPDX-License-Identifier: LGPL-3.0-only
# SPDX-FileCopyrightText: Copyright (C) 2026 mplx <mplx@jennifer-lang.dev>
# pragma-jennifer-version: >=0.28.0

# javaser - test fixtures: streams written by the JDK (OpenJDK 17) with
# testdata/gen/Fixtures.java, gzip + base64. Generated by
# testdata/gen/embed.j; do not edit. Spliced into javaser_test.j via include.

');
io.printf(
    "def const FIXTURES as map of string to string init \{\n%s\n\};\n",
    strings.join($entries, ",\n"));
io.printf(
    "%s",
    '
/**
 * The bytes of a fixture stream.
 *
 * @param name {string} the fixture, a key of FIXTURES
 * @return {bytes} the stream
 */
func fixture(name as string) {
    return compress.unpack("gzip", encoding.fromText("base64", FIXTURES[$name]));
}
');
